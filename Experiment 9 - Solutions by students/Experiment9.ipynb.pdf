/Pg 16 0 R
/K [28]
>>
endobj
327 0 obj
<<
/Type /StructElem
/S /P
/P 54 0 R
/E (A higher IoU indicates greater overlap between the predicted and actual bounding boxes.)
/Pg 16 0 R
/K [29]
>>
endobj
